# ---------------------------------------------------------------------------
# Backend environment configuration
# Copy to `.env` and fill in real values. NEVER commit the real .env.
# ---------------------------------------------------------------------------

# Server
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed browser origins (no trailing slash).
# Use the exact deployed frontend URL(s) in production.
FRONTEND_URL=http://localhost:5173

# --- Security (REQUIRED in production; the server refuses to start without them) ---
# Long random string used to sign admin session JWTs. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
# Admin console password. Login is disabled until this is set.
ADMIN_PASSWORD=
# Shared secret required to call the serverless queue-drain endpoint
# (GET /api/jobs/process-queue). Also used by the Vercel cron.
CRON_SECRET=
# Optional: key for encrypting credentials saved in Settings (defaults to
# JWT_SECRET). Set it if you might rotate JWT_SECRET; changing it later means
# re-entering saved credentials.
# SETTINGS_ENCRYPTION_KEY=
# Optional: reverse proxies in front of the app (1 for Render; 2 if you add
# e.g. Cloudflare in front). Wrong values break rate limiting.
# TRUST_PROXY_HOPS=1

# --- Supabase (database) ---
# Use the SERVICE ROLE key on the server (it must bypass RLS). Keep it secret;
# never expose it to the browser. See backend/migrations/003_enable_rls.sql.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your_supabase_service_role_key

# --- Twilio (WhatsApp provider option A) ---
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Optional API key auth instead of auth token:
# TWILIO_API_KEY=your_twilio_api_key_sid
# TWILIO_API_SECRET=your_twilio_api_secret
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_MODE=sandbox
STATUS_CALLBACK_URL=http://localhost:5000/api/webhook/twilio/status

# --- Meta WhatsApp Cloud API (provider option B; used automatically if configured) ---
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
# Any long random string; also entered in Meta's webhook setup. Required —
# there is no default, so Meta verification is refused until it's set.
META_WEBHOOK_VERIFY_TOKEN=
# App Secret used to verify inbound webhook signatures (X-Hub-Signature-256).
# REQUIRED to accept Meta webhooks in production.
META_APP_SECRET=
META_API_VERSION=v18.0

# --- Misc ---
# Country code given to numbers written without one (a leading 0, or 10
# digits or fewer), e.g. 91 for India. Numbers from other countries must
# include their country code or use the import's Country Code column.
DEFAULT_COUNTRY_CODE=91
# web | worker | all  (use a dedicated 'worker' process off serverless hosts)
PROCESS_TYPE=all
